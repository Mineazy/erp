  location  String?
  remarks   String?
  createdAt DateTime   @default(now()) @map("created_at")
  branchId  String?    @map("branch_id")
  asset     ErpAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  branch    ErpBranch? @relation(fields: [branchId], references: [id])

  @@index([assetId], map: "erp_asset_audit_logs_asset_id_fkey")
  @@index([branchId], map: "erp_asset_audit_logs_branch_id_fkey")
  @@map("erp_asset_audit_logs")
}

model ErpPrepaidFuel {
  id                   String   @id @default(uuid())
  fuelType             String   @map("fuel_type")
  balanceLiters        Decimal  @map("balance_liters") @db.Decimal(15, 2)
  currentPricePerLiter Decimal  @map("current_price_per_liter") @db.Decimal(15, 2)
  lastTopUpAmount      Decimal  @map("last_top_up_amount") @db.Decimal(15, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("erp_prepaid_fuel")
}

model ErpPrepaidFuelLog {
  id            String   @id @default(uuid())
  fuelType      String   @map("fuel_type")
  action        String
  quantity      Decimal  @db.Decimal(15, 2)
  pricePerLiter Decimal  @map("price_per_liter") @db.Decimal(15, 2)
  amount        Decimal  @db.Decimal(15, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("erp_prepaid_fuel_logs")
}

model ErpFuelRequisition {
  id                       String     @id @default(uuid())
  vehicleId                String     @map("vehicle_id")
  userId                   String     @map("user_id")
  userName                 String     @map("user_name")
  fuelType                 String     @default("'Diesel'") @map("fuel_type")
  litersRequested          Decimal    @map("liters_requested") @db.Decimal(15, 2)
  status                   String
  purpose                  String
  approvedBy               String?    @map("approved_by")
  treasurerApprovedBy      String?    @map("treasurer_approved_by")
  financeManagerApprovedBy String?    @map("finance_manager_approved_by")
  qrCodeUrl                String?    @map("qr_code_url")
  redeemToken              String?    @map("redeem_token")
  gasStation               String?    @map("gas_station")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")
  vehicle                  ErpVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId], map: "erp_fuel_requisitions_vehicle_id_fkey")
  @@map("erp_fuel_requisitions")
}

model ErpHaulingTrip {
  id                    String     @id @default(uuid())
  vehicleId             String     @map("vehicle_id")
  driverName            String     @map("driver_name")
  sourceWarehouseId     String?    @map("source_warehouse_id")
  sourceWarehouseName   String?    @map("source_warehouse_name")
  destinationBranchId   String?    @map("destination_branch_id")
  destinationBranchName String?    @map("destination_branch_name")
  status                String
  productDetails        String     @map("product_details") @db.Text
  departureTime         DateTime?  @map("departure_time")
  arrivalTime           DateTime?  @map("arrival_time")
  createdAt             DateTime   @default(now()) @map("created_at")
  vehicle               ErpVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId], map: "erp_hauling_trips_vehicle_id_fkey")
  @@map("erp_hauling_trips")
}

model ErpBackOrder {
  id          String             @id @default(uuid())
  orderNumber String             @unique @map("order_number")
  branchId    String             @map("branch_id")
  status      String             @default("'draft'")
  requestedBy String             @map("requested_by")
  approvedBy  String?            @map("approved_by")
  approvedAt  DateTime?          @map("approved_at")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  lines       ErpBackOrderLine[]
  branch      ErpBranch          @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "erp_back_orders_branch_id_fkey")
  @@map("erp_back_orders")
}

model ErpBackOrderLine {
  id             String       @id @default(uuid())
  backOrderId    String       @map("back_order_id")
  productId      String       @map("product_id")
  productName    String       @map("product_name")
  requestedQty   Decimal      @map("requested_qty") @db.Decimal(15, 2)
  allocatedQty   Decimal      @default(0.00) @map("allocated_qty") @db.Decimal(15, 2)
  outstandingQty Decimal      @map("outstanding_qty") @db.Decimal(15, 2)
  status         String       @default("'pending'")
  notes          String?
  backOrder      ErpBackOrder @relation(fields: [backOrderId], references: [id], onDelete: Cascade)

  @@index([backOrderId], map: "erp_back_order_lines_back_order_id_fkey")
  @@map("erp_back_order_lines")
}
