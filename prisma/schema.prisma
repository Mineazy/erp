generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  changes    String   @db.LongText
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model CurrencyRate {
  id           String   @id @default(uuid())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(15, 6)
  date         DateTime @default(now())
  source       String   @default("'manual'")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("currency_rates")
}

model TaxType {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  category     String
  rate         Decimal          @db.Decimal(5, 2)
  isActive     Boolean          @default(true) @map("is_active")
  rules        String?          @db.LongText
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  transactions TaxTransaction[]

  @@map("tax_types")
}

model TaxTransaction {
  id            String     @id @default(uuid())
  reference     String
  referenceType String     @map("reference_type")
  taxTypeId     String     @map("tax_type_id")
  taxableAmount Decimal    @map("taxable_amount") @db.Decimal(15, 2)
  taxAmount     Decimal    @map("tax_amount") @db.Decimal(15, 2)
  rate          Decimal    @db.Decimal(5, 2)
  currency      String     @default("'USD'")
  exchangeRate  Decimal    @default(1.000000) @map("exchange_rate") @db.Decimal(15, 6)
  postedToTaRMS Boolean    @default(false) @map("posted_to_tarms")
  createdAt     DateTime   @default(now()) @map("created_at")
  branchId      String?    @map("branch_id")
  branch        ErpBranch? @relation(fields: [branchId], references: [id])
  taxType       TaxType    @relation(fields: [taxTypeId], references: [id])

  @@index([branchId], map: "tax_transactions_branch_id_fkey")
  @@index([taxTypeId], map: "tax_transactions_tax_type_id_fkey")
  @@map("tax_transactions")
}

model WithholdingTaxCertificate {
  id             String   @id @default(uuid())
  certificateNo  String   @unique @map("certificate_no")
  supplierId     String   @map("supplier_id")
  supplierName   String   @map("supplier_name")
  supplierTin    String?  @map("supplier_tin")
  invoiceRef     String   @map("invoice_ref")
  grossAmount    Decimal  @map("gross_amount") @db.Decimal(15, 2)
  whtAmount      Decimal  @map("wht_amount") @db.Decimal(15, 2)
  rate           Decimal  @db.Decimal(5, 2)
  itf263Verified Boolean  @default(false) @map("itf263_verified")
  period         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("withholding_tax_certificates")
}

model FdmsDevice {
  id                  String               @id @default(uuid())
  deviceId            String               @unique @map("device_id")
  serialNo            String               @unique @map("serial_no")
  activationKey       String?              @map("activation_key")
  certificate         String?              @db.Text
  privateKey          String?              @map("private_key") @db.Text
  status              String               @default("'registered'")
  fiscalDayNo         Int                  @default(0) @map("fiscal_day_no")
  receiptCounter      Int                  @default(0) @map("receipt_counter")
  receiptGlobalNo     Int                  @default(0) @map("receipt_global_no")
  lastSyncAt          DateTime?            @map("last_sync_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  branchId            String?              @map("branch_id")
  branch              ErpBranch?           @relation(fields: [branchId], references: [id])
  fiscalisedDocuments FiscalisedDocument[]

  @@index([branchId], map: "fdms_devices_branch_id_fkey")
  @@map("fdms_devices")
}

model FiscalisedDocument {
  id              String             @id @default(uuid())
  documentType    String             @map("document_type")
  documentRef     String             @map("document_ref")
  deviceId        String             @map("device_id")
  fiscalDayNo     Int                @map("fiscal_day_no")
  receiptNo       Int                @map("receipt_no")
  receiptGlobalNo Int                @map("receipt_global_no")
  authCode        String?            @map("auth_code")
  qrCodeData      String?            @map("qr_code_data")
  qrCodeUrl       String?            @map("qr_code_url")
  submittedAt     DateTime?          @map("submitted_at")
  status          String             @default("'pending'")
  errorMessage    String?            @map("error_message")
  retryCount      Int                @default(0) @map("retry_count")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  branchId        String?            @map("branch_id")
  posTransaction  ErpPosTransaction?
  branch          ErpBranch?         @relation(fields: [branchId], references: [id])
  device          FdmsDevice         @relation(fields: [deviceId], references: [id])

  @@index([branchId], map: "fiscalised_documents_branch_id_fkey")
  @@index([deviceId], map: "fiscalised_documents_device_id_fkey")
  @@map("fiscalised_documents")
}

model ErpChartOfAccounts {
  id           String               @id @default(uuid())
  code         String               @unique
  name         String
  type         String
  category     String?
  isHeader     Boolean              @default(false) @map("is_header")
  parentId     String?              @map("parent_id")
  balance      Decimal              @default(0.00) @db.Decimal(15, 2)
  currency     String               @default("'USD'")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  parent       ErpChartOfAccounts?  @relation("ChartOfAccountsTree", fields: [parentId], references: [id])
  children     ErpChartOfAccounts[] @relation("ChartOfAccountsTree")
  journalLines ErpJournalLine[]

  @@index([parentId], map: "erp_chart_of_accounts_parent_id_fkey")
  @@map("erp_chart_of_accounts")
}

model ErpJournalEntry {
  id           String           @id @default(uuid())
  entryNumber  String           @unique @map("entry_number")
  description  String
  entryDate    DateTime         @map("entry_date")
  period       String
  status       String           @default("'draft'")
  postedAt     DateTime?        @map("posted_at")
  postedBy     String?          @map("posted_by")
  currency     String           @default("'USD'")
  exchangeRate Decimal          @default(1.000000) @map("exchange_rate") @db.Decimal(15, 6)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  branchId     String?          @map("branch_id")
  branch       ErpBranch?       @relation(fields: [branchId], references: [id])
  lines        ErpJournalLine[]

  @@index([branchId], map: "erp_journal_entries_branch_id_fkey")
  @@map("erp_journal_entries")
}

model ErpJournalLine {
  id          String             @id @default(uuid())
  entryId     String             @map("entry_id")
  accountId   String             @map("account_id")
  description String?
  debit       Decimal            @default(0.00) @db.Decimal(15, 2)
  credit      Decimal            @default(0.00) @db.Decimal(15, 2)
  currency    String             @default("'USD'")
  createdAt   DateTime           @default(now()) @map("created_at")
  account     ErpChartOfAccounts @relation(fields: [accountId], references: [id])
  entry       ErpJournalEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "erp_journal_lines_account_id_fkey")
  @@index([entryId], map: "erp_journal_lines_entry_id_fkey")
  @@map("erp_journal_lines")
}

model ErpAccountReceivable {
  id              String     @id @default(uuid())
  invoiceNumber   String     @unique @map("invoice_number")
  customerId      String     @map("customer_id")
  customerName    String     @map("customer_name")
  invoiceDate     DateTime   @map("invoice_date")
  dueDate         DateTime   @map("due_date")
  amount          Decimal    @db.Decimal(15, 2)
  paidAmount      Decimal    @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  balance         Decimal    @db.Decimal(15, 2)
  status          String     @default("'pending'")
  currency        String     @default("'USD'")
  description     String?
  journalEntryId  String?    @map("journal_entry_id")
  fiscalisedDocId String?    @map("fiscalised_doc_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  branchId        String?    @map("branch_id")
  branch          ErpBranch? @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "erp_accounts_receivable_branch_id_fkey")
  @@map("erp_accounts_receivable")
}

model ErpAccountPayable {
  id             String     @id @default(uuid())
  billNumber     String     @unique @map("bill_number")
  supplierId     String     @map("supplier_id")
  supplierName   String     @map("supplier_name")
  billDate       DateTime   @map("bill_date")
  dueDate        DateTime   @map("due_date")
  amount         Decimal    @db.Decimal(15, 2)
  paidAmount     Decimal    @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  balance        Decimal    @db.Decimal(15, 2)
  status         String     @default("'pending'")
  currency       String     @default("'USD'")
  description    String?
  journalEntryId String?    @map("journal_entry_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  branchId       String?    @map("branch_id")
  branch         ErpBranch? @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "erp_accounts_payable_branch_id_fkey")
  @@map("erp_accounts_payable")
}

model ErpCashbook {
  id           String     @id @default(uuid())
  entryNumber  String     @unique @map("entry_number")
  entryDate    DateTime   @map("entry_date")
  type         String
  accountId    String     @map("account_id")
  description  String
  amount       Decimal    @db.Decimal(15, 2)
  currency     String     @default("'USD'")
  exchangeRate Decimal    @default(1.000000) @map("exchange_rate") @db.Decimal(15, 6)
  reference    String?
  status       String     @default("'posted'")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  branchId     String?    @map("branch_id")
  branch       ErpBranch? @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "erp_cashbook_branch_id_fkey")
  @@map("erp_cashbook")
}

model ErpProduct {
  id              String              @id @default(uuid())
  code            String              @unique
  name            String
  description     String?
  categoryId      String?             @map("category_id")
  unit            String              @default("'each'")
  costPrice       Decimal             @default(0.00) @map("cost_price") @db.Decimal(15, 2)
  sellingPrice    Decimal             @default(0.00) @map("selling_price") @db.Decimal(15, 2)
  stock           Decimal             @default(0.00) @db.Decimal(15, 2)
  minStock        Decimal             @default(0.00) @map("min_stock") @db.Decimal(15, 2)
  maxStock        Decimal?            @default(0.00) @map("max_stock") @db.Decimal(15, 2)
  location        String?
  barcode         String?
  costingMethod   String              @default("'weighted_average'") @map("costing_method")
  isActive        Boolean             @default(true) @map("is_active")
  grade           String?
  purity          Decimal?            @db.Decimal(5, 2)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  branchId        String?             @map("branch_id")
  batches         ErpProductBatch[]
  branch          ErpBranch?          @relation(fields: [branchId], references: [id])
  category        ErpProductCategory? @relation(fields: [categoryId], references: [id])
  warehouseStocks ErpWarehouseStock[]

  @@index([branchId], map: "erp_products_branch_id_fkey")
  @@index([categoryId], map: "erp_products_category_id_fkey")
  @@map("erp_products")
}

model ErpProductCategory {
  id        String       @id @default(uuid())
  name      String
  parentId  String?      @map("parent_id")
  createdAt DateTime     @default(now()) @map("created_at")
  products  ErpProduct[]

  @@map("erp_product_categories")
}

model ErpProductBatch {
  id         String     @id @default(uuid())
  productId  String     @map("product_id")
  batchNo    String     @map("batch_no")
  serialNo   String?    @map("serial_no")
  quantity   Decimal    @db.Decimal(15, 2)
  costPrice  Decimal    @map("cost_price") @db.Decimal(15, 2)
  receivedAt DateTime   @default(now()) @map("received_at")
  expiryDate DateTime?  @map("expiry_date")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  product    ErpProduct @relation(fields: [productId], references: [id])

  @@index([productId], map: "erp_product_batches_product_id_fkey")
  @@map("erp_product_batches")
}

model ErpSalesOrder {
  id           String              @id @default(uuid())
  orderNumber  String              @unique @map("order_number")
  customerId   String              @map("customer_id")
  customerName String              @map("customer_name")
  orderDate    DateTime            @map("order_date")
  status       String              @default("'draft'")
  subtotal     Decimal             @db.Decimal(15, 2)
  taxAmount    Decimal             @default(0.00) @map("tax_amount") @db.Decimal(15, 2)
  discount     Decimal             @default(0.00) @db.Decimal(15, 2)
  total        Decimal             @db.Decimal(15, 2)
  currency     String              @default("'USD'")
  exchangeRate Decimal             @default(1.000000) @map("exchange_rate") @db.Decimal(15, 6)
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  branchId     String?             @map("branch_id")
  lines        ErpSalesOrderLine[]
  branch       ErpBranch?          @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "erp_sales_orders_branch_id_fkey")
  @@map("erp_sales_orders")
}

model ErpSalesOrderLine {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  productId   String        @map("product_id")
  productName String        @map("product_name")
  quantity    Decimal       @db.Decimal(15, 2)
  unitPrice   Decimal       @map("unit_price") @db.Decimal(15, 2)
  total       Decimal       @db.Decimal(15, 2)
  order       ErpSalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "erp_sales_order_lines_order_id_fkey")
  @@map("erp_sales_order_lines")
}

model ErpPurchaseOrder {
  id            String                  @id @default(uuid())
  poNumber      String                  @unique @map("po_number")
  supplierId    String                  @map("supplier_id")
  supplierName  String                  @map("supplier_name")
  orderDate     DateTime                @map("order_date")
  expectedDate  DateTime?               @map("expected_date")
  status        String                  @default("'draft'")
  subtotal      Decimal                 @db.Decimal(15, 2)
  taxAmount     Decimal                 @default(0.00) @map("tax_amount") @db.Decimal(15, 2)
  total         Decimal                 @db.Decimal(15, 2)
  currency      String                  @default("'USD'")
  exchangeRate  Decimal                 @default(1.000000) @map("exchange_rate") @db.Decimal(15, 6)
  notes         String?
  requisitionId String?                 @map("requisition_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  branchId      String?                 @map("branch_id")
  lines         ErpPurchaseOrderLine[]
  branch        ErpBranch?              @relation(fields: [branchId], references: [id])
  requisition   ErpPurchaseRequisition? @relation(fields: [requisitionId], references: [id])

  @@index([branchId], map: "erp_purchase_orders_branch_id_fkey")
  @@index([requisitionId], map: "erp_purchase_orders_requisition_id_fkey")
  @@map("erp_purchase_orders")
}

model ErpPurchaseOrderLine {
  id          String           @id @default(uuid())
  poId        String           @map("po_id")
  productId   String           @map("product_id")
  productName String           @map("product_name")
  quantity    Decimal          @db.Decimal(15, 2)
  receivedQty Decimal          @default(0.00) @map("received_qty") @db.Decimal(15, 2)
  unitPrice   Decimal          @map("unit_price") @db.Decimal(15, 2)
  total       Decimal          @db.Decimal(15, 2)
  po          ErpPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId], map: "erp_purchase_order_lines_po_id_fkey")
  @@map("erp_purchase_order_lines")
}

model ErpGoodsReceipt {
  id                 String                @id @default(uuid())
  receiptNo          String                @unique @map("receipt_no")
  supplierId         String?               @map("supplier_id")
  supplierName       String?               @map("supplier_name")
  receivedAt         DateTime              @default(now()) @map("received_at")
  status             String                @default("'Pending Review'")
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  branchId           String?               @map("branch_id")
  approvedAt         DateTime?             @map("approved_at")
  attachments        String?               @db.LongText
  capturedBy         String?               @map("captured_by")
  deliveryNoteNumber String?               @map("delivery_note_number")
  insightPoNumber    String?               @map("insight_po_number")
  invoiceNumber      String?               @map("invoice_number")
  reviewedBy         String?               @map("reviewed_by")
  reviewerSignature  String?               @map("reviewer_signature") @db.LongText
  lines              ErpGoodsReceiptLine[]
  branch             ErpBranch?            @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "erp_goods_receipts_branch_id_fkey")
  @@map("erp_goods_receipts")
}

model ErpGoodsReceiptLine {
  id          String          @id @default(uuid())
  receiptId   String          @map("receipt_id")
  productId   String          @map("product_id")
  productName String          @map("product_name")
  quantity    Decimal         @db.Decimal(15, 2)
  batchNo     String?         @map("batch_no")
  serialNo    String?         @map("serial_no")
  location    String?
  createdAt   DateTime        @default(now()) @map("created_at")
  acceptedQty Decimal         @default(0.00) @map("accepted_qty") @db.Decimal(15, 2)
  damagedQty  Decimal         @default(0.00) @map("damaged_qty") @db.Decimal(15, 2)
  orderedQty  Decimal         @default(0.00) @map("ordered_qty") @db.Decimal(15, 2)
  remarks     String?
  receipt     ErpGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId], map: "erp_goods_receipt_lines_receipt_id_fkey")
  @@map("erp_goods_receipt_lines")
}

model ErpPurchaseRequisition {
  id            String                       @id @default(uuid())
  requisitionNo String                       @unique @map("requisition_no")
  requestedBy   String                       @map("requested_by")
  department    String
  requiredDate  DateTime                     @map("required_date")
  status        String                       @default("'draft'")
  notes         String?
  approvedBy    String?                      @map("approved_by")
  approvedAt    DateTime?                    @map("approved_at")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  branchId      String?                      @map("branch_id")
  pos           ErpPurchaseOrder[]
  items         ErpPurchaseRequisitionItem[]
  branch        ErpBranch?                   @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "erp_purchase_requisitions_branch_id_fkey")
  @@map("erp_purchase_requisitions")
}

model ErpPurchaseRequisitionItem {
  id            String                 @id @default(uuid())
  requisitionId String                 @map("requisition_id")
  productId     String                 @map("product_id")
  productName   String                 @map("product_name")
  quantity      Decimal                @db.Decimal(15, 2)
  estimatedCost Decimal                @map("estimated_cost") @db.Decimal(15, 2)
  notes         String?
  createdAt     DateTime               @default(now()) @map("created_at")
  requisition   ErpPurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId], map: "erp_purchase_requisition_items_requisition_id_fkey")
  @@map("erp_purchase_requisition_items")
}

model ErpCustomer {
  id                 String     @id @default(uuid())
  code               String     @unique
  name               String
  type               String     @default("'company'")
  segment            String?    @default("'retail'")
  contactPerson      String?    @map("contact_person")
  email              String?
  phone              String?
  mobile             String?
  address            String?
  city               String?
  country            String?
  taxId              String?    @map("tax_id")
  vatNumber          String?    @map("vat_number")
  tinNumber          String?    @map("tin_number")
  creditLimit        Decimal    @default(0.00) @map("credit_limit") @db.Decimal(15, 2)
  balance            Decimal    @default(0.00) @db.Decimal(15, 2)
  notes              String?
  isActive           Boolean    @default(true) @map("is_active")
  loyaltyCardBarcode String?    @unique @map("loyalty_card_barcode")
  loyaltyPoints      Int        @default(0) @map("loyalty_points")
  totalSpent         Decimal    @default(0.00) @map("total_spent") @db.Decimal(15, 2)
  cardBalance        Decimal    @default(0.00) @map("card_balance") @db.Decimal(15, 2)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  branchId           String?    @map("branch_id")
  resellerDiscount   Decimal    @default(0.00) @map("reseller_discount") @db.Decimal(5, 2)
  walletBalance      Decimal    @default(0.00) @map("wallet_balance") @db.Decimal(15, 2)
  branch             ErpBranch? @relation(fields: [branchId], references: [id])
  leads              ErpLead[]

  @@index([branchId], map: "erp_customers_branch_id_fkey")
  @@map("erp_customers")
}

model ErpLead {
  id                String               @id @default(uuid())
  customerId        String?              @map("customer_id")
  companyName       String               @map("company_name")
  contactName       String               @map("contact_name")
  email             String?
  phone             String?
  source            String?
  stage             String               @default("'new'")
  value             Decimal              @default(0.00) @db.Decimal(15, 2)
  probability       Int                  @default(0)
  assignedTo        String?              @map("assigned_to")
  notes             String?
  expectedCloseDate DateTime?            @map("expected_close_date")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  interactions      ErpLeadInteraction[]
  customer          ErpCustomer?         @relation(fields: [customerId], references: [id])

  @@index([customerId], map: "erp_leads_customer_id_fkey")
  @@map("erp_leads")
}

model ErpLeadInteraction {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  type      String
  subject   String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  lead      ErpLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId], map: "erp_lead_interactions_lead_id_fkey")
  @@map("erp_lead_interactions")
}

model ErpSupplier {
  id               String                @id @default(uuid())
  code             String                @unique
  name             String
  contactPerson    String?               @map("contact_person")
  email            String?
  phone            String?
  address          String?
  city             String?
  country          String?
  taxId            String?               @map("tax_id")
  vatNumber        String?               @map("vat_number")
  tinNumber        String?               @map("tin_number")
  itf263Status     String                @default("'unknown'") @map("itf263_status")
  itf263Expiry     DateTime?             @map("itf263_expiry")
